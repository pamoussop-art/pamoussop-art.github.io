rules_version = '2';

// Règles de sécurité de la base Firestore du portfolio.
// - Tout le monde peut LIRE (le site public affiche les données).
// - Seul TON compte administrateur peut ÉCRIRE.
//
// UID du compte administrateur (Firebase > Authentication > Utilisateurs).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'viNhGzfGOTQmgu5dF86BC9Ipqxl1';
    }

    function validSkill() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.category is string && d.category.size() > 0 && d.category.size() <= 30
        && d.icon is string && d.visible is bool && d.order is number;
    }

    function validProject() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && d.description is string && d.description.size() > 0 && d.description.size() <= 300
        && d.tech is list && d.tech.size() <= 10
        && d.status in ['en-cours', 'termine']
        && d.visible is bool && d.order is number;
    }

    function validService() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 50
        && d.description is string && d.description.size() > 0 && d.description.size() <= 200
        && d.icon in ['web', 'api', 'mobile', 'pwa', 'idea', 'tools']
        && d.visible is bool && d.order is number;
    }

    match /skills/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validSkill();
      allow delete: if isAdmin();
    }

    match /projects/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validProject();
      allow delete: if isAdmin();
    }

    match /services/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validService();
      allow delete: if isAdmin();
    }

    match /settings/site {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tout le reste est interdit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
